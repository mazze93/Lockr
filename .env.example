# LOCKR environment configuration — copy to .env and fill in.
# Never commit the real .env.

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@localhost:5432/lockr

# Session signing secret — generate with: openssl rand -hex 32 (required)
SESSION_SECRET=

# Server port (default 5000)
PORT=5000

NODE_ENV=development

# Object storage paths (Replit object storage; only needed when using media uploads)
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=
